{
  "name": "ethereum-annual-rings",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "stylelint": "stylelint \"**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test",
    "test:e2e": "playwright test",
    "test:all": "npm run format && npm run lint && npm run stylelint && npm run typecheck && npm run test && npm run build",
    "deadcode": "knip",
    "audit": "npm audit --audit-level=high",
    "data:seed": "tsx scripts/seed-market-data.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@vercel/blob": "^2.0.0",
    "next": "16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "knip": "^5.82.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.2",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,yml,yaml,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix",
    "*.css": [
      "prettier --write",
      "stylelint --fix"
    ]
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1",
    "pre-commit": "npx --no -- lint-staged"
  }
}
